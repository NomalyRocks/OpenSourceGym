# OpenGym production environment variables (for docker-compose.prod.yml).
#
#   cp .env.production.example .env
#   docker compose -f docker-compose.prod.yml up -d --build
#
# A development install does not use this file; copy .env.example for that.
# The two cannot be merged into one file: both docker compose and Node's
# --env-file reader take the LAST value of a repeated key, so in a combined
# file the lower profile silently overrides the upper one.
#
# ONLY the variables compose actually reads live here. NODE_ENV, PORT,
# MONGODB_URI, REDIS_URL, BETTER_AUTH_URL and TRUSTED_ORIGINS are not listed:
# compose derives them from the values below, and defining them here would only
# create a second, conflicting source.

# The domain the panel and the API are served from. The certificate is issued
# for this name and its DNS record must point at this server. The panel and the
# API SHARE the domain — on separate subdomains the session cookie becomes
# third-party and sign-in breaks.
DOMAIN=spor.example.com

# Where Let's Encrypt notifications (certificate expiry and so on) are sent.
ACME_EMAIL=yonetici@example.com

# Mongo root user. The database publishes no port to the host, yet
# authentication is still mandatory — a single layer is not trusted.
MONGO_USER=opengym
MONGO_PASSWORD=

# Redis password (requirepass).
REDIS_PASSWORD=

# REQUIRED, at least 32 characters: openssl rand -base64 32
# apps/api/src/env.ts validates this in production; the API exits at startup
# if the value is invalid.
BETTER_AUTH_SECRET=

# Exposes the /api/docs and /api/openapi.json endpoints. Keep it off on a
# publicly reachable install.
ENABLE_API_DOCS=false

# IANA time zone that decides where the daily buckets in reports are cut.
# The gym's local day is authoritative; grouping by UTC would shift entries
# near midnight into the neighbouring day. An invalid value fails at startup.
REPORTS_TIME_ZONE=Europe/Istanbul

# Cloudflare R2 — profile photos. ALL of these are required in production:
# assertProductionProfilePhotoConfig refuses to start the process when the
# configuration is incomplete. R2_PUBLIC_BASE_URL must be a public custom
# domain bound to the bucket (e.g. https://media.example.com; r2.dev stays
# disabled in production).
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
R2_PUBLIC_BASE_URL=

# SMTP. Left empty, verification codes are written to the container log
# instead of being e-mailed and members cannot finish signing up; renewal
# reminders are not delivered either. Fill this in on a real install.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=OpenGym <noreply@example.com>

# NOTE: the mobile app's EXPO_PUBLIC_API_URL is NOT read from this file. Expo
# reads the environment under apps/mobile on the machine the app is built on,
# and a production build must use https://<DOMAIN>
# (apps/mobile/src/lib/config.ts).
