# OpenGym production ortam değişkenleri (docker-compose.prod.yml için).
#
#   cp .env.production.example .env
#   docker compose -f docker-compose.prod.yml up -d --build
#
# Development kurulumu bu dosyayı kullanmaz; onun için .env.example'ı kopyalayın.
# İkisi tek dosyada birleştirilemez: hem docker compose hem Node'un --env-file
# okuyucusu aynı anahtarın SON değerini alır, dolayısıyla birleşik bir dosyada
# alttaki profil üsttekini sessizce ezer.
#
# Burada YALNIZCA compose'un gerçekten okuduğu değişkenler vardır. NODE_ENV,
# PORT, MONGODB_URI, REDIS_URL, BETTER_AUTH_URL ve TRUSTED_ORIGINS listelenmez:
# onları compose aşağıdaki değerlerden kendisi türetir, burada tanımlamak
# yalnızca çelişkili ikinci bir kaynak yaratır.

# Panelin ve API'nin servis edildiği alan adı. Sertifika bu isme alınır; DNS
# kaydı bu sunucuya işaret etmelidir. Panel ve API AYNI alan adını paylaşır —
# oturum çerezi ayrı alt alan adlarında üçüncü taraf olur ve giriş kırılır.
DOMAIN=spor.example.com

# Let's Encrypt bildirimlerinin (sertifika süresi vb.) gideceği adres.
ACME_EMAIL=yonetici@example.com

# Mongo kök kullanıcısı. Veritabanı host'a port açmaz, yine de kimlik
# doğrulama zorunludur — tek katmana güvenilmez.
MONGO_USER=opengym
MONGO_PASSWORD=

# Redis parolası (requirepass).
REDIS_PASSWORD=

# ZORUNLU, en az 32 karakter: openssl rand -base64 32
# apps/api/src/env.ts production'da bunu doğrular; geçersizse API açılışta kapanır.
BETTER_AUTH_SECRET=

# /api/docs ve /api/openapi.json uçlarını açar. Herkese açık kurulumda
# kapalı tutun.
ENABLE_API_DOCS=false

# Raporlardaki günlük kovaların sınırını belirleyen IANA saat dilimi.
# Salonun yerel günü esas alınır; UTC'ye göre gruplamak gece yarısına yakın
# geçişleri komşu güne kaydırır. Geçersiz bir değer açılışta hata verir.
REPORTS_TIME_ZONE=Europe/Istanbul

# Cloudflare R2 — profil fotoğrafları. Production'da HEPSİ zorunludur:
# assertProductionProfilePhotoConfig eksik yapılandırmada süreci başlatmaz.
# R2_PUBLIC_BASE_URL bucket'a bağlı public custom domain olmalıdır
# (ör. https://media.example.com; production'da r2.dev kapalı tutulur).
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
R2_PUBLIC_BASE_URL=

# SMTP. Boş bırakılırsa doğrulama kodları e-posta yerine konteyner loguna
# yazılır ve üyeler kaydını tamamlayamaz; yenileme hatırlatmaları da gitmez.
# Gerçek kurulumda doldurun.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=OpenGym <noreply@example.com>

# NOT: Mobil uygulamanın EXPO_PUBLIC_API_URL değeri bu dosyadan OKUNMAZ.
# Expo, uygulamanın derlendiği makinede apps/mobile altındaki ortamı okur ve
# production derlemesinde https://<DOMAIN> olmalıdır (apps/mobile/src/lib/config.ts).
