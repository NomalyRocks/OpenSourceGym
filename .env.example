# Required: generate with openssl rand -base64 32
BETTER_AUTH_SECRET=

# Password of the first admin account, used only while no admin exists yet.
# Left empty in development, the seed falls back to "admin1234". Production has
# no such fallback: see .env.production.example.
INITIAL_ADMIN_PASSWORD=

# Compose Mongo/Redis addresses for pnpm dev (host ports 27018/6380).
# Left empty, the defaults 27017/6379 apply — if a system mongod/redis is
# running on the machine, that connects to the wrong server.
MONGODB_URI=mongodb://127.0.0.1:27018/opengym-dev
REDIS_URL=redis://127.0.0.1:6380

# The address the API is reached at from the outside
BETTER_AUTH_URL=http://localhost:3000

# Web panel origins (comma-separated)
TRUSTED_ORIGINS=http://localhost:5173

# API documentation is always on in development.
# Set to true in production to expose /api/docs and /api/openapi.json.
ENABLE_API_DOCS=false

# Cloudflare R2 — profile photos
# R2_PUBLIC_BASE_URL must be a public custom domain bound to the bucket
# (e.g. https://media.example.com; r2.dev stays disabled in production).
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
R2_PUBLIC_BASE_URL=

# IANA time zone that decides where the daily buckets in reports are cut.
# The gym's local day is authoritative; grouping by UTC would shift entries
# near midnight into the neighbouring day. An invalid value fails at startup.
REPORTS_TIME_ZONE=Europe/Istanbul

# SMTP (left empty, e-mails are printed to the console in development)
# Renewal reminders are sent through this; SMTP must actually be configured
# before the feature is enabled in the gym settings.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=OpenGym <noreply@opengym.local>

# A production install does NOT use this file: see .env.production.example.
# The two profiles cannot be merged into one file — both Node's --env-file
# reader and docker compose take the LAST value of a repeated key, so a
# production block appended below would silently override the development
# values above.
