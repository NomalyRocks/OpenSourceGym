# Zorunlu: openssl rand -base64 32 ile üretin
BETTER_AUTH_SECRET=

# pnpm dev için compose Mongo/Redis adresleri (host portları 27018/6380).
# Boş bırakılırsa varsayılan 27017/6379 kullanılır — makinede sistem
# mongod/redis çalışıyorsa yanlış sunucuya bağlanılır.
MONGODB_URI=mongodb://127.0.0.1:27018/opengym-dev
REDIS_URL=redis://127.0.0.1:6380

# API'nin dışarıdan erişildiği adres
BETTER_AUTH_URL=http://localhost:3000

# Web panel origin'leri (virgülle ayrılır)
TRUSTED_ORIGINS=http://localhost:5173

# API belgeleri development ortamında her zaman açıktır.
# Production'da /api/docs ve /api/openapi.json için true yapın.
ENABLE_API_DOCS=false

# Cloudflare R2 — profil fotoğrafları
# R2_PUBLIC_BASE_URL bucket'a bağlı public custom domain olmalıdır
# (ör. https://media.example.com; production'da r2.dev kapalı tutulur).
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
R2_PUBLIC_BASE_URL=

# Raporlardaki günlük kovaların sınırını belirleyen IANA saat dilimi.
# Salonun yerel günü esas alınır; UTC'ye göre gruplamak gece yarısına yakın
# geçişleri komşu güne kaydırır. Geçersiz bir değer açılışta hata verir.
REPORTS_TIME_ZONE=Europe/Istanbul

# SMTP (boş bırakılırsa dev ortamında e-postalar konsola yazılır)
# Yenileme hatırlatmaları buradan gönderilir; salon ayarlarından açılmadan
# önce SMTP'nin gerçekten yapılandırılmış olması gerekir.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=OpenGym <noreply@opengym.local>

# Production

# Production çalışma modunu etkinleştirir.
NODE_ENV=production

# API dinleme portu (varsayılan: 3000).
PORT=3000

# Production compose ağında 127.0.0.1 yerine servis adlarını kullanın.
MONGODB_URI=mongodb://mongo:27017/opengym
REDIS_URL=redis://redis:6379

# Gerçek HTTPS alan adlarını kullanın; birden fazla origin virgülle ayrılır.
BETTER_AUTH_URL=https://api.example.com
TRUSTED_ORIGINS=https://admin.example.com

# Production'da ZORUNLUDUR ve en az 32 karakter olmalıdır.
# apps/api/src/env.ts doğrulamayı yapar; geçersizse uygulama açılışta kapanır.
BETTER_AUTH_SECRET=production-icin-en-az-32-karakterlik-gizli-anahtar

# Mobil uygulamanın API adresi production'da HTTPS olmalıdır.
EXPO_PUBLIC_API_URL=https://api.example.com
