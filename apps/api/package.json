{
  "name": "@opengym/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "tsx --test src/*.test.ts src/**/*.test.ts",
    "lint": "eslint src",
    "dev": "tsx watch --env-file-if-exists=../../.env src/index.ts",
    "start": "node dist/index.js"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1130.0",
    "@better-auth/expo": "^1.7.4",
    "@opengym/shared": "workspace:*",
    "better-auth": "^1.7.4",
    "express": "^5.1.0",
    "libphonenumber-js": "^1.13.13",
    "mongodb": "^7.6.0",
    "nodemailer": "^9.0.3",
    "redis": "^6.2.1",
    "sharp": "^0.35.4",
    "swagger-ui-express": "^5.0.1",
    "ws": "^8.21.3",
    "zod": "^4.6.2",
    "zod-openapi": "^6.0.2"
  },
  "devDependencies": {
    "@types/express": "^5.0.0",
    "@types/node": "^24.0.0",
    "@types/nodemailer": "^8.0.1",
    "@types/ws": "^8.18.1",
    "tsx": "^4.20.0"
  }
}
