{
  "name": "@opengym/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "tsx --test src/*.test.ts src/**/*.test.ts",
    "lint": "eslint src",
    "dev": "tsx watch --env-file-if-exists=../../.env src/index.ts",
    "start": "node dist/index.js",
    "seed:demo": "tsx --env-file-if-exists=../../.env scripts/seed-demo.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1085.0",
    "@better-auth/expo": "^1.6.23",
    "@opengym/shared": "workspace:*",
    "better-auth": "^1.6.23",
    "express": "^5.1.0",
    "libphonenumber-js": "^1.13.8",
    "mongodb": "^7.4.0",
    "nodemailer": "^10.0.9",
    "redis": "^6.1.0",
    "sharp": "^0.35.5",
    "swagger-ui-express": "^5.0.1",
    "ws": "^8.18.0",
    "zod": "^4.4.3",
    "zod-openapi": "^6.0.0"
  },
  "devDependencies": {
    "@types/express": "^5.0.0",
    "@types/node": "^24.0.0",
    "@types/nodemailer": "^8.0.1",
    "@types/ws": "^8.18.1",
    "tsx": "^4.23.12"
  }
}
