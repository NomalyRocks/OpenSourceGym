{
  "name": "@opengym/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "tsx --test src/*.test.ts src/**/*.test.ts",
    "lint": "eslint src",
    "dev": "tsx watch --env-file-if-exists=../../.env src/index.ts",
    "start": "node dist/index.js",
    "seed:demo": "tsx --env-file-if-exists=../../.env scripts/seed-demo.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1158.0",
    "@better-auth/expo": "^1.7.14",
    "@opengym/shared": "workspace:*",
    "better-auth": "^1.7.14",
    "express": "^5.3.0",
    "libphonenumber-js": "^1.13.15",
    "mongodb": "^7.7.0",
    "nodemailer": "^10.2.1",
    "redis": "^6.3.0",
    "sharp": "^0.35.5",
    "swagger-ui-express": "^5.0.1",
    "ws": "^8.22.0",
    "zod": "^4.6.7",
    "zod-openapi": "^6.0.2"
  },
  "devDependencies": {
    "@types/express": "^5.0.0",
    "@types/node": "^24.0.0",
    "@types/nodemailer": "^8.0.2",
    "@types/ws": "^8.18.2",
    "tsx": "^4.23.15"
  }
}
