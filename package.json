{
  "name": "opengym",
  "private": true,
  "version": "0.1.0",
  "packageManager": "pnpm@11.3.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "typecheck": "turbo run typecheck",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "mobile": "pnpm --filter @opengym/mobile start",
    "mobile:clear": "pnpm --filter @opengym/mobile start --clear",
    "mobile:android": "pnpm --filter @opengym/mobile android",
    "sim": "node agents/sim/fleet.mjs",
    "sim:setup": "node agents/sim/fleet.mjs setup"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.13.0",
    "prettier": "^3.9.10",
    "turbo": "^2.11.10",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.1"
  }
}
