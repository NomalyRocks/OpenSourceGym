# OpenGym reverse proxy. Certificates are obtained and renewed automatically
# from Let's Encrypt, which requires ports 80 and 443 to be reachable from the
# outside and DOMAIN to resolve to this server.
{
	email {$ACME_EMAIL}
}

{$DOMAIN} {
	encode zstd gzip

	# The panel and the API are served from the same origin: the panel calls the
	# API over relative paths with a cookie session. Separate subdomains would
	# make those cookies third-party and break the session.
	handle /api/* {
		reverse_proxy api:3000
	}

	handle {
		reverse_proxy web:80
	}

	# /health and /health/ready are NOT exposed publicly: the readiness response
	# names the component that is down. Check them from the server instead:
	#   docker compose -f docker-compose.prod.yml exec api \
	#     node -e "fetch('http://127.0.0.1:3000/health/ready').then(r=>r.text()).then(console.log)"

	header {
		# HSTS: stop the browser from ever reaching this domain over plain HTTP.
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "strict-origin-when-cross-origin"
		# Do not leak the server version
		-Server
	}

	log {
		output stdout
		format console
	}
}
