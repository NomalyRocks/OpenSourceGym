# OpenGym ters vekili. Sertifikalar Let's Encrypt'ten otomatik alınır ve
# yenilenir; bunun için 80 ve 443 portları dışarıdan erişilebilir olmalı ve
# DOMAIN bu sunucuya çözülmelidir.
{
	email {$ACME_EMAIL}
}

{$DOMAIN} {
	encode zstd gzip

	# Panel ve API aynı origin'den servis edilir: panel API'ye göreli yollarla
	# ve çerez tabanlı oturumla gider. Ayrı alt alan adları çerezleri üçüncü
	# taraf yapar ve oturumu kırardı.
	handle /api/* {
		reverse_proxy api:3000
	}

	handle {
		reverse_proxy web:80
	}

	# /health ve /health/ready dışarıya AÇILMAZ: readiness yanıtı hangi alt
	# bileşenin düştüğünü söyler. İzleme için sunucu üzerinden:
	#   docker compose -f docker-compose.prod.yml exec api \
	#     node -e "fetch('http://127.0.0.1:3000/health/ready').then(r=>r.text()).then(console.log)"

	header {
		# HSTS: tarayıcı bu alan adına bir daha düz HTTP ile gitmesin.
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "strict-origin-when-cross-origin"
		# Sunucu sürümünü sızdırma
		-Server
	}

	log {
		output stdout
		format console
	}
}
