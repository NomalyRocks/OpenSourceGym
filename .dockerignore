# Limits the Docker build context to the files image production actually needs.

# Dependencies and build output
node_modules
**/node_modules
**/dist
.turbo
**/.turbo

# Git and local environment files
.git
.env
.env.*

# Images, reports and prototypes not needed at runtime
login-visual.png
sast/
spor-salonu-ye-dashboard/
sports-salon-dashboard-design/

# Documentation and repository settings
docs/
.github/
/*.md

# Editor settings
.vscode/
.idea/

# The mobile app and tests, unused in the server images
apps/mobile/
**/*.test.ts
apps/api/src/integration/
